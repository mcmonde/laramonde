#!/usr/bin/env bash
# Thin CLI around docker compose — prints every command it runs.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/_lib.sh
source "$ROOT/scripts/_lib.sh"

run() {
  echo "+ $*"
  "$@"
}

# Prefer <app>-octane, else <app>-php (FPM).
app_http_service() {
  local app="$1"
  local services
  services="$("${COMPOSE[@]}" config --services 2>/dev/null || true)"
  if echo "$services" | grep -qx "${app}-octane"; then
    echo "${app}-octane"
  elif echo "$services" | grep -qx "${app}-php"; then
    echo "${app}-php"
  else
    echo "No http service for app '${app}' (expected ${app}-php or ${app}-octane)." >&2
    return 1
  fi
}

# name, signature, description, section, kind (alias or empty). Tabs separate fields.
command_catalog() {
  printf '%s\n' \
    $'help\thelp [command]\tDisplay help for a command\troot\t' \
    $'list\tlist\tList commands\troot\t' \
    $'about\tabout\tShow whether this host is development or production\troot\t' \
    $'install\tinstall [options]\tFirst install when no apps are registered\troot\t' \
    $'setup\tsetup [--rotate-secrets]\tCreate .env and generate secrets\troot\t' \
    $'validate\tvalidate\tCompose config and bash -n on scripts\troot\t' \
    $'up\tup [services...]\tStart the stack in the background\tstack\t' \
    $'down\tdown [options]\tStop the stack\tstack\t' \
    $'ps\tps [options]\tList containers\tstack\t' \
    $'logs\tlogs [services...]\tFollow logs\tstack\t' \
    $'restart\trestart [services...]\tRestart services\tstack\t' \
    $'build\tbuild [services...]\tBuild images\tstack\t' \
    $'config\tconfig\tRender the compose config\tstack\t' \
    $'exec\texec <service> [cmd...]\tRun a command in a service container\tstack\t' \
    $'new-app\tnew-app <name> [host]\tScaffold an app, database, and nginx vhost\tapp\t' \
    $'scan-app\tscan-app <repo-url|path>\tReport what an app needs before new-app\tapp\t' \
    $'extras\textras <app> [options]\tShow or set per-app PHP extensions and packages\tapp\t' \
    $'apps\tapps [app]\tList apps, or one app, without secrets\tapp\t' \
    $'remove-app\tremove-app <name>\tRemove an app from the stack\tapp\t' \
    $'artisan\tartisan <app> [args...]\tRun php artisan in the app container\tapp\t' \
    $'composer\tcomposer <app> [args...]\tRun composer in the app container\tapp\t' \
    $'workspace\tworkspace\tShell in the workspace container\tapp\t' \
    $'site:render\tsite:render <app>\tRe-render the nginx vhost for an app\tapp\t' \
    $'db:create\tdb:create <name>\tCreate the app database on a running Postgres\tdatabase\t' \
    $'backup\tbackup [db]\tDump app databases\tdatabase\t' \
    $'resources\tresources [sub]\tAssess or apply host CPU and RAM limits\tresources\t' \
    $'profile\tprofile <small|medium|large>\tApply a fixed CPU and RAM preset\tresources\t' \
    $'scale\tscale [sub]\tAlias of resources\tresources\talias' \
    $'tls:issue\ttls:issue <app>\tIssue a certificate and switch the vhost to HTTPS\ttls\t' \
    $'tls:disable\ttls:disable <app>\tSwitch an app back to HTTP-only nginx\ttls\t' \
    $'tls:renew\ttls:renew\tRenew certificates and reload nginx\ttls\t' \
    $'tls:certs\ttls:certs\tList certificates and days remaining\ttls\t' \
    $'tls:status\ttls:status [app]\tShow TLS status\ttls\t'
}

catalog_field() {
  local want="$1" field="$2"
  local name sig desc section kind
  while IFS=$'\t' read -r name sig desc section kind; do
    [[ -z "${name:-}" ]] && continue
    [[ "$name" == "$want" ]] || continue
    case "$field" in
      sig) printf '%s\n' "$sig" ;;
      desc) printf '%s\n' "$desc" ;;
      section) printf '%s\n' "$section" ;;
      kind) printf '%s\n' "$kind" ;;
      *) return 1 ;;
    esac
    return 0
  done < <(command_catalog)
  return 1
}

print_command_list() {
  local name sig desc section kind current=""
  while IFS=$'\t' read -r name sig desc section kind; do
    [[ -z "${name:-}" ]] && continue
    [[ "${kind:-}" == "alias" ]] && continue
    if [[ "$section" != "$current" ]]; then
      current="$section"
      if [[ "$section" != "root" ]]; then
        echo
        echo " ${section}"
      fi
    fi
    printf '  %-34s %s\n' "$sig" "$desc"
  done < <(command_catalog)
}

command_extra() {
  case "$1" in
    about)
      cat <<'EOF'

Reads the root .env and prints COMPOSE_PROFILES, NGINX_BIND, CERTBOT_STAGING,
MEILI_ENV, and RESOURCE_MODE. No other keys are printed.

Development: a dev profile and NGINX_BIND=127.0.0.1.
Production: no dev or mail profile, NGINX_BIND=0.0.0.0, and CERTBOT_STAGING=0.
A missing .env, or a mix that matches neither, exits non-zero.
EOF
      ;;
    install)
      cat <<'EOF'

Options:
  --env development|production   Host mode (dev and prod are accepted)
  --name <app>                   First app name
  --laravel                      Development: latest Laravel into apps/<name>
  --git <url>                    Development: clone that repository into apps/<name>
  --no-interaction, -n           Do not ask; require the flags above
  --dry-run                      Print the questions or the plan; write nothing

Development writes COMPOSE_PROFILES=dev,search, NGINX_BIND=127.0.0.1,
CERTBOT_STAGING=1, MEILI_ENV=development, RESOURCE_MODE=auto.
Production writes COMPOSE_PROFILES=tls, NGINX_BIND=0.0.0.0,
CERTBOT_STAGING=0, MEILI_ENV=production, RESOURCE_MODE=unlimited.
Production skips the Laravel/git question. RESOURCE_MODE=unlimited is the
small-host default; on a larger host set RESOURCE_MODE=auto afterwards.

Asks only when no sites/<app>/compose.yml include exists. Template names
that start with _ are ignored. A later run with an app included does not ask.

Preview the questions without answering:
  ./dock install --dry-run

DOCK_INSTALL_COMPOSE_FILE  Read includes from this file (fixture).
EOF
      ;;
    setup)
      cat <<'EOF'

Options:
  --rotate-secrets    Force-regenerate Postgres, Redis, and Meilisearch secrets
EOF
      ;;
    up|down|ps|restart|build|config|exec)
      cat <<'EOF'

Extra arguments are passed to docker compose.
EOF
      ;;
    logs)
      cat <<'EOF'

Follows logs (docker compose logs -f). Extra arguments are passed through.
EOF
      ;;
    new-app)
      cat <<'EOF'

Options:
  --octane             Scaffold Octane/Swoole instead of PHP-FPM
  --spa                / → SPA, /api → Laravel, /app → Reverb
  --php X.Y            Per-app PHP 8.1–8.5 (default: PHP_VERSION in .env)
  --php-ext "a b"      Per-app PHP extensions (own image tag)
  --apt "x y"          Per-app Debian packages
  --force              Create even if the resource check fails
  --skip-scale         Skip the capacity check and rescale

Non-interactive capacity prompt: --force, or RESOURCES_ASSUME_YES=1.
EOF
      ;;
    scan-app)
      cat <<'EOF'

Options:
  --branch NAME    Branch to scan (git URLs)
  --php X.Y        Check against this PHP version
  --no-docker      Static scan only
EOF
      ;;
    extras)
      cat <<'EOF'

Options:
  --php-ext "a b"    PHP extensions for this app
  --apt "x y"        Debian packages for this app
  --clear            Remove extras and return to the shared image

With no options, show the current extras.
EOF
      ;;
    remove-app)
      cat <<'EOF'

Options:
  --drop-db        Drop the Postgres database and role
  --remove-code    Delete apps/<name>/
  --force          Skip the confirmation prompt

The database and the Laravel code are kept unless those flags are set.
Non-interactive confirmation: --force, or RESOURCES_ASSUME_YES=1.
EOF
      ;;
    resources|scale)
      cat <<'EOF'

Subcommands:
  assess                 Show host CPU/RAM capacity (default)
  apply                  Write scaled limits (or clear them if unlimited)
  status                 Show the current per-app resource plan
  weight <app> <n>       Set a share weight, then rescale
  pin <app>              Freeze an app's limits
  unpin <app>            Allow auto-scale again and rescale

RESOURCE_MODE=auto|unlimited in .env. Soft prompts honor
RESOURCES_ASSUME_YES=1 and DOCK_NO_INTERACTION=1.
EOF
      ;;
    profile)
      cat <<'EOF'

Sets RESOURCE_MODE=auto, then merges profiles/<name>.env into .env.
EOF
      ;;
    backup)
      cat <<'EOF'

With no database name, dump every app database plus globals.
Spaces upload follows BACKUP_* in .env.
EOF
      ;;
    tls:issue)
      cat <<'EOF'

Options:
  --staging    Use the Let's Encrypt staging endpoint
  --force      Continue when a certificate already exists

CERTBOT_STAGING=1 in .env also selects staging.
EOF
      ;;
    db:create)
      cat <<'EOF'

Reads the database, role, and password from postgres/apps.list.
The password is not printed.
EOF
      ;;
  esac
}

usage() {
  cat <<'EOF'
multi-app dock

Usage:
  ./dock <command> [options] [arguments]

Options:
  -h, --help                 Display help for a command, or this list
  help [command]             Help for one command
  list                       List commands

Available commands:
EOF
  print_command_list
  cat <<'EOF'

For up, down, ps, logs, restart, build, config, and exec, extra arguments
are passed to docker compose.
EOF
  if [[ -z "$(registered_app_names)" ]]; then
    cat <<'EOF'

No apps yet. First install: ./dock install
Preview the questions: ./dock install --dry-run
EOF
  fi
}

edit_distance() {
  local a="$1" b="$2"
  local i j alen blen cost del ins sub m
  alen=${#a}
  blen=${#b}
  if [[ "$alen" -eq 0 ]]; then
    echo "$blen"
    return 0
  fi
  if [[ "$blen" -eq 0 ]]; then
    echo "$alen"
    return 0
  fi
  local -a prev curr
  for ((j = 0; j <= blen; j++)); do
    prev[j]=$j
  done
  for ((i = 1; i <= alen; i++)); do
    curr[0]=$i
    for ((j = 1; j <= blen; j++)); do
      cost=1
      if [[ "${a:i-1:1}" == "${b:j-1:1}" ]]; then
        cost=0
      fi
      del=$((curr[j - 1] + 1))
      ins=$((prev[j] + 1))
      sub=$((prev[j - 1] + cost))
      m=$del
      if [[ "$ins" -lt "$m" ]]; then
        m=$ins
      fi
      if [[ "$sub" -lt "$m" ]]; then
        m=$sub
      fi
      curr[j]=$m
    done
    for ((j = 0; j <= blen; j++)); do
      prev[j]=${curr[j]}
    done
  done
  echo "${prev[blen]}"
}

suggest_commands() {
  local input="$1" name sig desc section kind dist
  local -a hits=()
  [[ ${#input} -le 40 ]] || return 0
  while IFS=$'\t' read -r name sig desc section kind; do
    [[ -z "${name:-}" ]] && continue
    dist="$(edit_distance "$input" "$name")"
    if [[ "$name" == "$input"* || "$input" == "$name"* || "$dist" -le 2 ]]; then
      hits+=("${dist}"$'\t'"${name}")
    fi
  done < <(command_catalog)
  [[ ${#hits[@]} -gt 0 ]] || return 0
  echo
  echo "Did you mean this?"
  printf '%s\n' "${hits[@]}" | sort -n -k1,1 -k2,2 | head -3 | cut -f2- | while IFS= read -r name; do
    printf '    %s\n' "$name"
  done
}

unknown_command() {
  local cmd="$1"
  echo "ERROR  Command \"${cmd}\" is not defined." >&2
  suggest_commands "$cmd" >&2 || true
  echo >&2
  echo "Run './dock list' to see every command." >&2
}

show_help() {
  local name="$1" sig desc
  if ! sig="$(catalog_field "$name" sig)"; then
    unknown_command "$name"
    return 1
  fi
  desc="$(catalog_field "$name" desc)"
  cat <<EOF
Description:
  ${desc}

Usage:
  ./dock ${sig}
EOF
  command_extra "$name"
}

cmd="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

if [[ -z "$cmd" || "$cmd" == "list" ]]; then
  if [[ $# -gt 0 ]]; then
    echo "list does not take arguments. See ./dock help." >&2
    exit 1
  fi
  usage
  exit 0
fi

if [[ "$cmd" == "help" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi
  if [[ $# -gt 1 ]]; then
    echo "help takes one command name." >&2
    exit 1
  fi
  show_help "$1"
  exit $?
fi

if ! catalog_field "$cmd" sig >/dev/null; then
  unknown_command "$cmd"
  exit 1
fi

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  show_help "$cmd"
  exit $?
fi

# install syncs publish.yml from setup, after it has written the host mode.
# about only reads .env.
if [[ "$cmd" != "install" && "$cmd" != "about" ]]; then
  "$ROOT/scripts/sync-publish.sh"
fi

case "$cmd" in
  setup)
    run "$ROOT/scripts/setup.sh" "$@"
    ;;
  up)
    run "${COMPOSE[@]}" up -d "$@"
    ;;
  down)
    run "${COMPOSE[@]}" down "$@"
    ;;
  ps)
    run "${COMPOSE[@]}" ps "$@"
    ;;
  logs)
    run "${COMPOSE[@]}" logs -f "$@"
    ;;
  restart)
    run "${COMPOSE[@]}" restart "$@"
    ;;
  build)
    run "${COMPOSE[@]}" build "$@"
    ;;
  config)
    run "${COMPOSE[@]}" config "$@"
    ;;
  workspace)
    run "${COMPOSE[@]}" exec workspace bash
    ;;
  artisan)
    app="${1:?app name required}"
    shift
    svc="$(app_http_service "$app")"
    run "${COMPOSE[@]}" exec "$svc" php artisan "$@"
    ;;
  composer)
    app="${1:?app name required}"
    shift
    svc="$(app_http_service "$app")"
    run "${COMPOSE[@]}" exec "$svc" composer "$@"
    ;;
  exec)
    run "${COMPOSE[@]}" exec "$@"
    ;;
  new-app)
    run "$ROOT/scripts/new-app.sh" "$@"
    ;;
  scan-app)
    run "$ROOT/scripts/scan-app.sh" "$@"
    ;;
  extras)
    run "$ROOT/scripts/extras.sh" "$@"
    ;;
  apps)
    run "$ROOT/scripts/apps.sh" "$@"
    ;;
  remove-app)
    run "$ROOT/scripts/remove-app.sh" "$@"
    ;;
  profile)
    run "$ROOT/scripts/apply-profile.sh" "$@"
    ;;
  resources|scale)
    if [[ $# -eq 0 ]]; then
      run "$ROOT/scripts/resources.sh" assess
    else
      run "$ROOT/scripts/resources.sh" "$@"
    fi
    ;;
  db:create)
    app="${1:?app name required}"
    list="$ROOT/postgres/apps.list"
    line="$(grep -E "^${app}[[:space:]]" "$list" || true)"
    if [[ -z "$line" ]]; then
      echo "No entry for $app in postgres/apps.list — run ./dock new-app first."
      exit 1
    fi
    db="$(echo "$line" | awk '{print $2}')"
    user="$(echo "$line" | awk '{print $3}')"
    pass="$(echo "$line" | awk '{print $4}')"
    # shellcheck disable=SC1091
    set -a
    # shellcheck source=/dev/null
    source "$ROOT/.env"
    set +a
    echo "+ create database ${db} (user ${user})"
    "$ROOT/scripts/create-app-db.sh" "$db" "$user" "$pass"
    ;;
  backup)
    run "$ROOT/scripts/backup-postgres.sh" "$@"
    ;;
  tls:issue)
    run "$ROOT/scripts/tls-issue.sh" "$@"
    ;;
  tls:disable)
    run "$ROOT/scripts/tls-disable.sh" "$@"
    ;;
  tls:renew)
    run "$ROOT/scripts/tls-renew.sh" "$@"
    ;;
  tls:certs)
    run "${COMPOSE[@]}" --profile tls run --rm --entrypoint certbot certbot certificates "$@"
    ;;
  tls:status)
    run "$ROOT/scripts/tls-status.sh" "$@"
    ;;
  site:render)
    run "$ROOT/scripts/render-site-nginx.sh" "$@"
    ;;
  validate)
    run "$ROOT/scripts/validate.sh"
    ;;
  install)
    "$ROOT/scripts/install.sh" "$@"
    ;;
  about)
    "$ROOT/scripts/about.sh" "$@"
    ;;
  *)
    unknown_command "$cmd"
    exit 1
    ;;
esac
