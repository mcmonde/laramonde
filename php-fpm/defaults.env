PHP_VERSION=8.4
PHP_IMAGE=multiapp-php
APP_UID=1000
APP_GID=1000
PHP_MEMORY_LIMIT=256M
PHP_MAX_CHILDREN=20
PHP_CPUS=2
PHP_MEMORY=1G
QUEUE_CPUS=1
QUEUE_MEMORY=512M
REVERB_CPUS=1
REVERB_MEMORY=512M
SCHEDULER_CPUS=0.5
SCHEDULER_MEMORY=256M
APP_QUEUE_COMMAND=php artisan queue:work --sleep=3 --tries=3 --max-time=3600
