APP_NAME=__APP__
APP_RUNTIME=fpm
APP_LAYOUT=standard
APP_TLS=0
PHP_VERSION=8.4
APP_DOMAIN=__DOMAIN__
APP_URL=http://__DOMAIN__

# Auto-scale share (default 1). Use 2+ for a heavier app; pin=1 freezes limits.
RESOURCE_WEIGHT=1
RESOURCE_PIN=0

DB_DATABASE=__DBIDENT__
DB_USERNAME=__DBIDENT__
DB_PASSWORD=change-me

REDIS_PREFIX=__APP___
SCOUT_PREFIX=__APP___

REVERB_APP_ID=__APP__
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me

APP_QUEUE_COMMAND=php artisan queue:work --sleep=3 --tries=3 --max-time=3600
