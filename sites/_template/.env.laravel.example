# Merge into the Laravel app's .env (apps/__APP__/.env), not the stack .env.

APP_NAME="__APP__"
APP_URL=http://__DOMAIN__
ASSET_URL=http://__DOMAIN__
FRONTEND_URL=http://__DOMAIN__
SANCTUM_STATEFUL_DOMAINS=__DOMAIN__
SESSION_DOMAIN=null

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=__DBIDENT__
DB_USERNAME=__DBIDENT__
DB_PASSWORD=__DB_PASSWORD__

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=__REDIS_PASSWORD__
REDIS_PORT=6379
REDIS_PREFIX=__APP___

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

SCOUT_DRIVER=__SCOUT_DRIVER__
MEILISEARCH_HOST=__MEILISEARCH_HOST__
MEILISEARCH_KEY=__MEILI_MASTER_KEY__
SCOUT_PREFIX=__APP___

MAIL_MAILER=__MAIL_MAILER__
MAIL_HOST=__MAIL_HOST__
MAIL_PORT=__MAIL_PORT__
MAIL_ENCRYPTION=null
MAIL_USERNAME=null
MAIL_PASSWORD=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=__APP__
REVERB_APP_KEY=__REVERB_APP_KEY__
REVERB_APP_SECRET=__REVERB_APP_SECRET__
REVERB_HOST=__DOMAIN__
REVERB_PORT=80
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
