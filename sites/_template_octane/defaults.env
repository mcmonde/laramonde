APP_NAME=__APP__
APP_RUNTIME=octane
APP_LAYOUT=standard
APP_TLS=0
# Per-app PHP (8.1–8.5). Not PHP_VERSION: the root .env value would override it.
APP_PHP_VERSION=8.4

# Per-app extras on top of the shared image (set with ./dock extras; see ./dock scan-app).
# Space-separated. Non-empty -> this app builds its own image tag (shares all base layers).
APP_PHP_EXTENSIONS=
APP_APT_PACKAGES=
APP_IMAGE_SUFFIX=

APP_DOMAIN=__DOMAIN__
APP_URL=http://__DOMAIN__

# Auto-scale share (default 1). Use 2+ for a heavier app; pin=1 freezes limits.
RESOURCE_WEIGHT=1
RESOURCE_PIN=0

DB_DATABASE=__DBIDENT__
DB_USERNAME=__DBIDENT__
DB_PASSWORD=change-me

REDIS_PREFIX=__APP___
SCOUT_PREFIX=__APP___

REVERB_APP_ID=__APP__
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me

OCTANE_WORKERS=4
OCTANE_TASK_WORKERS=2
OCTANE_MAX_REQUESTS=500
OCTANE_COMMAND=php artisan octane:start --server=swoole --host=0.0.0.0 --port=8000 --workers=4 --task-workers=2 --max-requests=500
APP_QUEUE_COMMAND=php artisan queue:work --sleep=3 --tries=3 --max-time=3600
