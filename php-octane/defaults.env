PHP_VERSION=8.4
PHP_OCTANE_IMAGE=multiapp-php-octane
APP_UID=1000
APP_GID=1000
OCTANE_PORT=8000
OCTANE_WORKERS=4
OCTANE_TASK_WORKERS=2
OCTANE_MAX_REQUESTS=500
OCTANE_CPUS=2
OCTANE_MEMORY=1G
QUEUE_CPUS=1
QUEUE_MEMORY=512M
REVERB_CPUS=1
REVERB_MEMORY=512M
SCHEDULER_CPUS=0.5
SCHEDULER_MEMORY=256M
APP_QUEUE_COMMAND=php artisan queue:work --sleep=3 --tries=3 --max-time=3600
OCTANE_COMMAND=php artisan octane:start --server=swoole --host=0.0.0.0 --port=8000 --workers=4 --task-workers=2 --max-requests=500
