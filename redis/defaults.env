REDIS_IMAGE=redis:8-alpine
REDIS_MAXMEMORY=2gb
# Apps keep cache, sessions AND queues here. volatile-lru only evicts keys with a TTL
# (cache entries, sessions); queued jobs have no TTL and are never evicted.
# allkeys-lru would silently drop queued jobs when Redis is full.
REDIS_MAXMEMORY_POLICY=volatile-lru
REDIS_CPUS=2
REDIS_MEMORY=4G
# Empty = not published. Example: 127.0.0.1:6379
REDIS_PUBLISH=
