# Shared stack settings. Copy to .env with: ./dock setup
# Service defaults live in <service>/defaults.env — override any of them here.

# Resource model: auto-detect THIS host (./dock resources assess|apply)
# Optional overrides only for testing: HOST_CPUS_OVERRIDE / HOST_MEM_MB_OVERRIDE
# Fixed presets (optional): ./dock profile small|medium|large
# RESOURCE_MODE=auto       → Docker CPU/RAM cgroup limits from the host plan (default)
# RESOURCE_MODE=unlimited  → no cgroup caps (cpus/memory 0); capacity hard-blocks become warnings
#                            Use on tiny droplets if needed; prefer more RAM when possible.
RESOURCE_MODE=auto

COMPOSE_PROJECT_NAME=multiapp
# Profiles (comma-separated):
#   dev     = workspace + mailpit
#   search  = meilisearch (also sets SCOUT_DRIVER=meilisearch via ./dock setup)
#   mail    = mailpit only
#   tls     = certbot renew loop
#   build   = php image builders
# Local default below. Lean prod: leave empty (Scout→null, Mail→log).
COMPOSE_PROFILES=dev,search
APP_UID=1000
APP_GID=1000

# Laravel projects: ./apps/<name>  or  ../PROJECTS
APP_CODE_PATH_HOST=./apps
APP_CODE_PATH_CONTAINER=/var/www/apps

# PHP used by workspace and as the default for new apps (8.1–8.5)
PHP_VERSION=8.4

# Bind published ports to loopback unless this host is the public edge
NGINX_BIND=127.0.0.1
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
MAILPIT_UI_BIND=127.0.0.1
MAILPIT_UI_PORT=8025

# Leave empty (recommended). Set only if you need host tools to reach them.
POSTGRES_PUBLISH=
REDIS_PUBLISH=
MEILI_PUBLISH=

# Required secrets — ./dock setup generates strong hex values.
# Placeholders below are rejected; never ship them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
REDIS_PASSWORD=change-me
MEILI_MASTER_KEY=change-me-min-16-chars

# Filled by ./dock setup from COMPOSE_PROFILES (do not hand-edit unless you know why)
# search on  → SCOUT_DRIVER=meilisearch, MEILISEARCH_HOST=http://meilisearch:7700
# search off → SCOUT_DRIVER=null, MEILISEARCH_HOST=
# dev|mail on  → MAIL_MAILER=smtp, MAIL_HOST=mailpit, MAIL_PORT=1025
# mail off     → MAIL_MAILER=log, MAIL_HOST=, MAIL_PORT=2525
SCOUT_DRIVER=null
MEILISEARCH_HOST=
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=2525

# Meilisearch: development | production (only when profile `search` is enabled)
MEILI_ENV=development

# Optional TLS / Let's Encrypt
# Set CERTBOT_EMAIL, then: ./dock tls:issue <app>
# Production edge: NGINX_BIND=0.0.0.0 and CERTBOT_STAGING=0
CERTBOT_EMAIL=
CERTBOT_STAGING=1

# Optional offsite Postgres backups (DigitalOcean Spaces / S3-compatible).
# ./dock backup              → all app DBs (+ globals)
# ./dock backup <db-name>    → one database
# Cron (staging/prod): 0 1 * * * cd /path/to/multi-app && ./dock backup >> logs/backup.log 2>&1
#
# Local/dev (default): leave BACKUP_S3_* unset and BACKUP_REQUIRE_SPACES=0
#   → dumps stay under backups/postgres/; no upload; exit 0
# Staging/prod: set BACKUP_S3_* and BACKUP_REQUIRE_SPACES=1
#   → private upload → verify → delete local; failed uploads retried next run
#   → prune Spaces objects older than BACKUP_S3_RETAIN_DAYS (default 30)
# BACKUP_REQUIRE_SPACES=0
# BACKUP_S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
# BACKUP_S3_REGION=sgp1
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=laramonde/postgres
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_RETAIN_DAYS=30
# Optional failure alerts (Slack/Discord-compatible webhook and/or email):
# BACKUP_ALERT_WEBHOOK=
# BACKUP_ALERT_EMAIL=
