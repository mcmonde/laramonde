.env
.env.*
!.env.example

sites/*/defaults.env
!sites/_template/defaults.env
!sites/_template_octane/defaults.env
sites/*/.env
sites/*/.env.laravel.example
!sites/_template/.env.laravel.example
!sites/_template_octane/.env.laravel.example

# App source is cloned / bind-mounted / synced locally — keep only .gitkeep placeholders
apps/**
!apps/
!apps/*/
!apps/*/.gitkeep

# Explicit build & dependency dirs (in case of nested checkouts)
**/node_modules/
**/vendor/
**/frontend/dist/
**/frontend/.output/
**/.nuxt/
**/.output/

.resources.plan

postgres/apps.list
certs/
certbot/www/
certbot/conf/

logs/
backups/

# Local nginx toggles (empty scaffold sites disabled to avoid DNS errors)
nginx/conf.d/sites/*.conf.disabled

*.pem
*.key
*.crt
!*.example

.idea/
.vscode/
*.swp
.DS_Store
