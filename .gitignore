.env
.env.*
!.env.example

# Generated per-app site dirs (./dock new-app). Keep scaffolding templates only.
sites/*
!sites/_template/
!sites/_template/**
!sites/_template_octane/
!sites/_template_octane/**

# App source is cloned / bind-mounted / deployed separately — keep placeholder only
apps/*
!apps/.gitkeep

# Generated nginx vhosts (+ backups from re-renders)
nginx/conf.d/sites/*
!nginx/conf.d/sites/.gitkeep

# Explicit build & dependency dirs (in case of nested checkouts)
**/node_modules/
**/vendor/
**/frontend/dist/
**/frontend/.output/
**/.nuxt/
**/.output/

.resources.plan

postgres/apps.list
certs/
certbot/www/
certbot/conf/

logs/
backups/

*.pem
*.key
*.crt
!*.example

.idea/
.vscode/
*.swp
.DS_Store
