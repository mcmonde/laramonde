# Medium host (~4 vCPU / 8–16GB). One or two Laravel apps.
# Usage: ./dock profile medium

COMPOSE_PROFILES=dev,search

NGINX_CPUS=0.5
NGINX_MEMORY=128M

POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE=2GB
POSTGRES_CPUS=1
POSTGRES_MEMORY=1G

REDIS_MAXMEMORY=256mb
REDIS_CPUS=0.5
REDIS_MEMORY=384M

MEILI_CPUS=0.5
MEILI_MEMORY=512M

PHP_CPUS=1
PHP_MEMORY=512M
PHP_MEMORY_LIMIT=256M
PHP_MAX_CHILDREN=10

QUEUE_CPUS=0.5
QUEUE_MEMORY=256M
REVERB_CPUS=0.5
REVERB_MEMORY=256M
SCHEDULER_CPUS=0.25
SCHEDULER_MEMORY=128M

OCTANE_CPUS=1
OCTANE_MEMORY=512M
OCTANE_COMMAND=php artisan octane:start --server=swoole --host=0.0.0.0 --port=8000 --workers=2 --task-workers=1 --max-requests=500

WORKSPACE_CPUS=1
WORKSPACE_MEMORY=1G
