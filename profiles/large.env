# Large host (~8+ vCPU / 32GB+). Defaults closer to the original stack.
# Usage: ./dock profile large

COMPOSE_PROFILES=dev,search

NGINX_CPUS=2
NGINX_MEMORY=256M

POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE=6GB
POSTGRES_CPUS=4
POSTGRES_MEMORY=8G

REDIS_MAXMEMORY=1gb
REDIS_CPUS=1
REDIS_MEMORY=2G

MEILI_CPUS=1
MEILI_MEMORY=2G

PHP_CPUS=2
PHP_MEMORY=1G
PHP_MEMORY_LIMIT=256M
PHP_MAX_CHILDREN=20

QUEUE_CPUS=1
QUEUE_MEMORY=512M
REVERB_CPUS=1
REVERB_MEMORY=512M
SCHEDULER_CPUS=0.5
SCHEDULER_MEMORY=256M

OCTANE_CPUS=2
OCTANE_MEMORY=1G
OCTANE_COMMAND=php artisan octane:start --server=swoole --host=0.0.0.0 --port=8000 --workers=4 --task-workers=2 --max-requests=500

WORKSPACE_CPUS=2
WORKSPACE_MEMORY=2G
