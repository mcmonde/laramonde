# Copy/merge into root .env for a 2 vCPU / ~4GB host.
# Usage: ./dock profile small
#
# Budget (one Laravel app):
#   OS ~0.8G | postgres ~0.5G | redis ~0.1G | nginx ~0.05G
#   php+queue+reverb+scheduler ~0.7–1.0G | meilisearch ~0.25G (optional)
# Headroom ~1G. Do NOT run hris+crms+api together on this size.

# No workspace / mailpit / meilisearch on tiny hosts (enable search later if needed)
COMPOSE_PROFILES=

NGINX_CPUS=0.25
NGINX_MEMORY=64M

POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE=512MB
POSTGRES_CPUS=0.5
POSTGRES_MEMORY=512M

REDIS_MAXMEMORY=64mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_CPUS=0.25
REDIS_MEMORY=128M

# Set MEILI_ENABLED=0 in .env and omit meilisearch if you don't need search
MEILI_CPUS=0.25
MEILI_MEMORY=256M
MEILI_ENV=production

PHP_CPUS=0.5
PHP_MEMORY=256M
PHP_MEMORY_LIMIT=128M
PHP_MAX_CHILDREN=5

QUEUE_CPUS=0.25
QUEUE_MEMORY=128M
REVERB_CPUS=0.25
REVERB_MEMORY=128M
SCHEDULER_CPUS=0.1
SCHEDULER_MEMORY=64M

OCTANE_CPUS=0.5
OCTANE_MEMORY=256M
OCTANE_COMMAND=php artisan octane:start --server=swoole --host=0.0.0.0 --port=8000 --workers=1 --task-workers=1 --max-requests=200

WORKSPACE_CPUS=0.5
WORKSPACE_MEMORY=512M
MAILPIT_CPUS=0.1
MAILPIT_MEMORY=64M
CERTBOT_CPUS=0.1
CERTBOT_MEMORY=64M
